# ============================================================================
# Ely — configuration. Copie ce fichier en .env et remplis ce dont tu as besoin.
# Une seule chose est indispensable : au moins un modèle (une clé d'API OU LM Studio).
# Tout le reste a une valeur par défaut qui marche.
# ============================================================================

# ---------------------------------------------------------------- serveur
ELY_PORT=8000
# Adresse publique (HTTPS) d'Ely, ex. via Tailscale : https://mac-studio.tail1234.ts.net
# Sert aux redirections OAuth (Google, LinkedIn) et aux liens dans les notifications.
ELY_PUBLIC_URL=
# Proxy (Tailscale, Caddy, cloudflared…) dont Ely croit l'en-tête X-Forwarded-For (adresse réelle des visiteurs, utilisée
# pour limiter les essais de mot de passe). Par défaut : un proxy sur ce Mac. Proxy sur une autre machine : son adresse.
# ELY_TRUSTED_PROXIES=127.0.0.1,::1
ELY_TIMEZONE=Europe/Paris
# Inscription libre (sinon : premier compte = admin, puis invitations)
ELY_OPEN_REGISTRATION=false

# ---------------------------------------------------------------- modèles
# Modèles locaux (gratuits). LM Studio : onglet Développeur → démarrer le serveur.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Voix clonée : service vocal XTTS de l'ancienne version, sur ce Mac (lu dans Réglages → Profil → Voix)
# XTTS_URL=http://127.0.0.1:8020
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Clés d'API : mets celles que tu as, Ely les utilise toutes (repli automatique).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
# Tout autre service compatible OpenAI :
# CUSTOM_OPENAI_BASE_URL=https://…/v1
# CUSTOM_OPENAI_API_KEY=

# Choix des modèles par rôle : « auto » = Ely choisit le meilleur disponible.
# Format fournisseur:modèle, ex. anthropic:claude-opus-5, openai:gpt-5, lmstudio:google/gemma-4-26b-a4b
# (modifiable aussi dans l'interface : Réglages → Modèles, l'interface a priorité).
ELY_MODEL_MAIN=auto        # l'agent qui réfléchit et agit
ELY_MODEL_STRONG=auto      # escalade quand l'agent piétine (vide = pas d'escalade), ex. anthropic:claude-fable-5-1
ELY_MODEL_FAST=auto        # contrôleur d'objectif, résumés
ELY_MODEL_LOCAL=auto       # mémoire et titres en tâche de fond (LM Studio de préférence)
ELY_MODEL_EMBED=auto       # vecteurs mémoire, ex. lmstudio:text-embedding-nomic-embed-text-v1.5
ELY_MODEL_FALLBACKS=auto   # liste séparée par des virgules, ou auto : tes autres choix puis les gratuits (jamais un payant non choisi)

# Abonnement ChatGPT (sans payer au token) : se connecte dans Réglages → Modèles (import de ~/.codex/auth.json).
# Modèles proposés pour ce fournisseur, séparés par des virgules :
# CHATGPT_MODELS=gpt-5.5

# ---------------------------------------------------------------- persévérance
ELY_MAX_STEPS=250            # étapes max d'une tâche (0 = illimité)
ELY_MAX_VERIFY_RETRIES=6     # relances max par le contrôleur d'objectif
ELY_CONTEXT_SOFT_LIMIT=90000 # au-delà (tokens estimés), le contexte est élagué puis résumé

# ---------------------------------------------------------------- recherche web
# Sans rien : DuckDuckGo & co (gratuit). Mieux : une instance SearXNG, ou une clé Tavily/Brave.
# Ordre d'essai : SearXNG → Serper → Exa → SearchCans → Google → Tavily → Brave → DuckDuckGo (gratuit, toujours là).
SEARXNG_URL=
SERPER_API_KEY=
EXA_API_KEY=
SEARCHCANS_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---------------------------------------------------------------- navigateur de l'agent
ELY_BROWSER_HEADLESS=true
# Utiliser le Chrome installé sur le Mac plutôt que Chromium : ELY_BROWSER_CHANNEL=chrome
ELY_BROWSER_CHANNEL=
ELY_BROWSER_EXECUTABLE=

# ---------------------------------------------------------------- exécution de code
ELY_ALLOW_CODE=true
# Python et terminal aussi pour les comptes non administrateurs (ils s'exécutent sur cette machine, avec ses droits)
ELY_ALLOW_CODE_FOR_ALL=false

# ---------------------------------------------------------------- intégrations
# Google (Gmail, Agenda, Contacts) — console.cloud.google.com → Identifiants → ID client OAuth « Application Web »
# URI de redirection autorisée : <ELY_PUBLIC_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn (publication par API) — linkedin.com/developers : produits « Sign In with LinkedIn » + « Share on LinkedIn »
# URI de redirection : <ELY_PUBLIC_URL>/api/integrations/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Telegram : crée un bot avec @BotFather et colle son jeton
TELEGRAM_BOT_TOKEN=
# Génération d'images (OpenAI ou Gemini, selon les clés présentes)
# ELY_IMAGE_MODEL=gpt-image-1
# ELY_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
